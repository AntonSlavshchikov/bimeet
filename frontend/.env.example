VITE_API_URL=http://localhost:8080
# Comma-separated list of admin emails. Only used for UI gating;
# the backend enforces access via its own ADMIN_EMAILS env var.
VITE_ADMIN_EMAILS=lozzyklingers@gmail.com
# Optional: VAPID public key for Web Push. If unset, the key is fetched from the
# backend at runtime (GET /api/push/vapid-public-key).
VITE_VAPID_PUBLIC_KEY=
