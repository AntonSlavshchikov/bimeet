{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:splash:light": "pwa-asset-generator branding/splash-light.svg public/splash --splash-only --type png --background \"#ffffff\" --padding \"22%\" --path \"/splash\"",
    "gen:splash:dark": "pwa-asset-generator branding/splash-dark.svg public/splash --splash-only --dark-mode --type png --background \"#0a0a0b\" --padding \"22%\" --path \"/splash\"",
    "gen:splash": "npm run gen:splash:light && npm run gen:splash:dark"
  },
