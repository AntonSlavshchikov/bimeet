# Copy to backup.env on the VM (chmod 600, NOT in the repo) at
# /opt/bimeet/backup/backup.env. Credentials are the backup_s3_* outputs
# from infra/terraform, NOT the app's own S3 credentials — see
# docs/runbooks/backup-restore.md.
BACKUP_S3_BUCKET=bimeet-prod-backups
S3_ENDPOINT=https://s3.ru-9.storage.selcloud.ru
AWS_ACCESS_KEY_ID=<backup_s3_access_key terraform output>
AWS_SECRET_ACCESS_KEY=<backup_s3_secret_key terraform output>
AWS_DEFAULT_REGION=ru-9
# AWS_CLI_DOCKER_NETWORK is NOT needed in prod (the VM reaches the real
# internet S3 endpoint directly). It only matters for local testing against
# dev-compose MinIO, where the aws-cli container must join the compose
# network to resolve the "minio" hostname — see docs/runbooks/backup-restore.md.
# AWS_CLI_DOCKER_NETWORK=bimeet-dev_default
