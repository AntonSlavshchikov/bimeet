[Unit]
Description=Daily Bimeet Postgres backup

[Timer]
# 03:17 UTC — off-peak, and not exactly on the hour so it doesn't line up
# with other hosts' cron/timer jobs hitting the same bucket at once.
OnCalendar=*-*-* 03:17:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
