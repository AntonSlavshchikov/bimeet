# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars.

selectel_domain   = "123456"
selectel_username = "bootstrap-admin"
selectel_password = "CHANGE-ME"

project_name = "bimeet"
environment  = "prod"
region       = "ru-9"
