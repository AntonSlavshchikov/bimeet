domain = "bimeet.pro"

admin_cidrs           = ["203.0.113.4/32"]
admin_ssh_public_key  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@host"

terraform_serviceuser_password = "CHANGE-ME"
ci_serviceuser_password        = "CHANGE-ME"
app_serviceuser_password       = "CHANGE-ME"
backup_serviceuser_password    = "CHANGE-ME"
