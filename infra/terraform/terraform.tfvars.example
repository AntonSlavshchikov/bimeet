# Copy to terraform.tfvars (git-ignored) and fill in. Fake values below.

timeweb_token = "eyJ...your-api-token..."

# Who may reach SSH. CI deploys from GitHub runners (changing IPs), so the
# working setup is open SSH with key-only auth. With a static IP and manual
# deploys only, narrow it to ["<your ip>/32"] (curl -4 -s https://ifconfig.me).
admin_cidrs = ["0.0.0.0/0"]

# Contents of ~/.ssh/id_ed25519.pub
admin_ssh_public_key = "ssh-ed25519 AAAA...example... you@laptop"

# Defaults: Moscow, 1 CPU / 2 GB RAM / 15 GB NVMe.
# location          = "ru-3"
# availability_zone = "msk-1"
# server = { cpu = 1, ram = 2048, disk = 15360 }
