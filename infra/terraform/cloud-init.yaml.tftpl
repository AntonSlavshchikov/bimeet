#cloud-config
# Hardening + Docker setup for the Bimeet prod VM. Idempotent on reboot;
# re-running Terraform does NOT re-run this (user_data only applies on
# first boot) — changes here need a new VM, see README "Changing cloud-init".

users:
  - name: deploy
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${admin_ssh_public_key}

# Root login and password auth disabled; key-only access for "deploy".
write_files:
  - path: /etc/ssh/sshd_config.d/99-bimeet-hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no

  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "5"
        }
      }

  # Postgres backup — script, systemd units, and its credentials. See
  # docs/runbooks/backup-restore.md for how to re-install this by hand on a
  # VM that already existed before this cloud-init change.
  - path: /opt/bimeet/backup/pg_backup.sh
    permissions: "0755"
    content: |
      ${indent(6, pg_backup_script)}

  - path: /opt/bimeet/backup/pg_restore.sh
    permissions: "0755"
    content: |
      ${indent(6, pg_restore_script)}

  - path: /opt/bimeet/backup/backup.env
    permissions: "0600"
    content: |
      BACKUP_S3_BUCKET=${backup_s3_bucket}
      S3_ENDPOINT=${backup_s3_endpoint}
      AWS_ACCESS_KEY_ID=${backup_s3_access_key}
      AWS_SECRET_ACCESS_KEY=${backup_s3_secret_key}
      AWS_DEFAULT_REGION=${backup_s3_region}

  - path: /etc/systemd/system/bimeet-backup.service
    content: |
      ${indent(6, backup_service_unit)}

  - path: /etc/systemd/system/bimeet-backup.timer
    content: |
      ${indent(6, backup_timer_unit)}

package_update: true
package_upgrade: true

packages:
  - ufw
  - fail2ban
  - unattended-upgrades
  - chrony
  - ca-certificates
  - curl
  - gnupg

runcmd:
  # Docker Engine + Compose plugin from Docker's own apt repo (the distro
  # repo's docker.io package lags far behind and lacks the compose plugin).
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - >
    echo "deb [arch=$(dpkg --print-architecture)
    signed-by=/etc/apt/keyrings/docker.asc]
    https://download.docker.com/linux/ubuntu
    $(. /etc/os-release && echo $VERSION_CODENAME) stable"
    > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  - systemctl enable --now docker

  # ufw: default deny, only the ports a human or Traefik needs directly.
  # Published container ports bypass ufw by talking to iptables/nftables
  # directly — the security group (security_group.tf) is the real perimeter;
  # ufw is defense in depth for anything accidentally bound on the host itself.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable

  - systemctl enable --now fail2ban

  # Security-only unattended upgrades, no automatic reboot — a surprise
  # reboot of the only prod VM is worse than a delayed kernel update.
  # Ubuntu ships this line commented out; uncomment it and force "false"
  # explicitly rather than relying on the (also commented-out) default.
  - sed -i 's|^//\?\s*Unattended-Upgrade::Automatic-Reboot .*|Unattended-Upgrade::Automatic-Reboot "false";|' /etc/apt/apt.conf.d/50unattended-upgrades
  - systemctl enable --now unattended-upgrades

  - systemctl enable --now chrony
  - timedatectl set-timezone UTC

  - fallocate -l 2G /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab

  - mkdir -p /opt/bimeet
  - chown deploy:deploy /opt/bimeet
  - chown -R root:root /opt/bimeet/backup
  - systemctl daemon-reload
  - systemctl enable --now bimeet-backup.timer

  - systemctl restart sshd
