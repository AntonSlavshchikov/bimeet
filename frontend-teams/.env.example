# Bimeet for Teams — frontend (локальная разработка)
# Адрес Teams-бэкенда (отдельный сервис, порт 8090).
VITE_API_URL=http://localhost:8090

# Локально поддомены эмулируем через *.lvh.me (резолвится в 127.0.0.1):
#   рабочее пространство компании:  http://acme.lvh.me:5174
#   регистрация новой компании:     http://company.lvh.me:5174  (или http://localhost:5174)
# Для отладки можно форсировать поддомен в обход хоста:
# VITE_DEV_SUBDOMAIN=acme
