# Bimeet for Teams — backend (локальная разработка, без деплоя)
# Отдельная БД, изолированная от People. Postgres из docker-compose.yml на
# host-порту 5433 (People занимает 5432) — поднять: `docker compose up -d`.
DSN=postgres://bimeet:bimeet@localhost:5433/bimeet_teams?sslmode=disable
JWT_SECRET=change-me-in-production
PORT=8090
JWT_EXP_HOURS=72

# CORS: список origin'ов через запятую. Пусто = "*" (удобно для локальных
# {company}.lvh.me:5174 dev-хостов). Аутентификация по Bearer-токену, не cookie.
CORS_ALLOWED_ORIGINS=

# MailHog (из docker-compose.yml) — письма-инвайты ловятся на http://localhost:8026.
# Пусто SMTP_HOST = письма не шлются, только логируются.
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM=noreply@bimeet.local

# Ссылка accept-invite в письме: {scheme}://{subdomain}.{base}/accept-invite?token=...
FRONTEND_SCHEME=http
FRONTEND_BASE_DOMAIN=lvh.me:5174
