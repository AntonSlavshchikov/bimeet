# Runtime environment for docker-compose.prod.yml.
# Copy to ~/bimeet/.env.prod on the VPS and replace every <...> value.
# Never commit the resulting .env.prod file.

# Docker Compose / images
GITHUB_REPOSITORY_OWNER=<lowercase-github-owner>

# PostgreSQL
POSTGRES_PASSWORD=<strong-random-password>
DSN=postgres://bimeet:<same-postgres-password>@postgres:5432/bimeet?sslmode=disable

# Backend
PORT=8080
APP_ENV=production
JWT_SECRET=<strong-random-secret>
JWT_EXP_HOURS=72
AUTH_TEST=false
FRONTEND_URL=https://app.bimeet.pro
CORS_ALLOWED_ORIGINS=https://app.bimeet.pro
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Passkey / WebAuthn
# For a migration-only first rollout set false, deploy, then switch to true.
PASSKEY_ENABLED=true
WEBAUTHN_RP_ID=app.bimeet.pro
WEBAUTHN_RP_ORIGINS=https://app.bimeet.pro
WEBAUTHN_RP_DISPLAY_NAME=Bimeet
# Generate once with: openssl rand -base64 32
# Never rotate while saved passkeys exist: old credential records would become unreadable.
PASSKEY_CREDENTIAL_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Email login (recommended: Resend HTTP API)
RESEND_API_KEY=<resend-api-key>
MAIL_FROM=Bimeet <noreply@bimeet.pro>

# Production MinIO from docker-compose.prod.yml
MINIO_ROOT_USER=<minio-user>
MINIO_ROOT_PASSWORD=<strong-random-password>
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<same-minio-user>
AWS_SECRET_ACCESS_KEY=<same-minio-password>
S3_BUCKET=avatars
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE_URL=https://s3.bimeet.pro/avatars

# Web Push. Generate once with: cd backend && go run ./cmd/genvapid
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:admin@bimeet.pro

# Chat encryption. Generate once with: openssl rand -base64 32
CHAT_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Logging / optional observability
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=bimeet-backend
GRAFANA_ADMIN_PASSWORD=<strong-random-password>

# Build-time GitHub Actions secrets (these do not belong in VPS runtime env):
# VITE_API_URL=https://app.bimeet.pro
# VITE_ADMIN_EMAILS=<same-admin-email-list>
# NEXT_PUBLIC_APP_URL=https://app.bimeet.pro
