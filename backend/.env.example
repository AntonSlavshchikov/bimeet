PORT=8080
DSN=postgres://bimeet:bimeet@localhost:5432/bimeet?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_EXP_HOURS=72
# Passwordless auth test mode. When true, login codes are NOT emailed and the
# code is always "120401" — keeps the email provider's quota intact in dev/tests.
AUTH_TEST=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Bimeet <noreply@bimeet.local>
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:5173
# Environment: "development" (default) or "production".
# In production CORS is restricted to CORS_ALLOWED_ORIGINS and HSTS is enabled.
APP_ENV=development
# Allowed CORS origins, comma-separated. Empty = permissive "*" (dev only).
# CORS_ALLOWED_ORIGINS=https://app.bimeet.pro
# Observability — structured logging (slog).
# LOG_LEVEL: debug/info/warn/error (default info).
LOG_LEVEL=info
# LOG_FORMAT: json/text. Empty resolves by APP_ENV (json in prod, text in dev).
# LOG_FORMAT=
# Observability — tracing (OpenTelemetry). Disabled by default = no-op, zero overhead.
# Set OTEL_ENABLED=true and point the SDK at a collector (e.g. local Jaeger:
#   docker run --rm -p16686:16686 -p4318:4318 jaegertracing/all-in-one)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# OTEL_SERVICE_NAME=bimeet-backend
# Admin panel: comma-separated emails allowed to access /api/admin/*
ADMIN_EMAILS=lozzyklingers@gmail.com
# Web Push (VAPID). Generate once with: go run ./cmd/genvapid (or webpush-go).
# Public key must also be exposed to the frontend as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bimeet.pro
# Chat at-rest encryption: base64-encoded 32-byte key (AES-256). If empty,
# message bodies are stored as plaintext. Generate with:
#   openssl rand -base64 32
CHAT_ENCRYPTION_KEY=
# S3-compatible storage (required for avatar uploads)
# For local dev with MinIO (docker-compose):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=avatars
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/avatars
# For production with MinIO behind Traefik (s3.bimeet.pro):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<key>
# AWS_SECRET_ACCESS_KEY=<secret>
# S3_BUCKET=avatars
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_BASE_URL=https://s3.bimeet.pro/avatars
# For production with AWS S3 (remove S3_ENDPOINT):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<key>
# AWS_SECRET_ACCESS_KEY=<secret>
# S3_BUCKET=<bucket>
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com
